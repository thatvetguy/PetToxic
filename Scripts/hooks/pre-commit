#!/bin/sh
# PetToxic pre-commit hook: content integrity checks.
# Installed copy lives at .git/hooks/pre-commit (git does not version hooks).
# Reinstall after cloning:  cp Scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Bypass in an emergency:   git commit --no-verify

REPO_ROOT="$(git rev-parse --show-toplevel)"
STAGED="$(git diff --cached --name-only)"

# Guard 1: Swift content services are the source of truth; committing them
# without the regenerated JSON ships different content on iOS vs Android.
fail_drift() {
    echo "Commit blocked: $1 is staged but $2 is not."
    echo "Content edits must be extracted and committed together:"
    echo "  run the extraction (see CLAUDE.md 'Extraction workflow'), then: git add $2"
    echo "If this Swift change touched NO content (pure code refactor), bypass with: git commit --no-verify"
    exit 1
}
echo "$STAGED" | grep -q '^PetToxic/Services/DatabaseService.swift$' && \
    ! echo "$STAGED" | grep -q '^Content/toxins.json$' && \
    fail_drift "DatabaseService.swift" "Content/toxins.json"
echo "$STAGED" | grep -q '^PetToxic/Services/DiseasesConditionsService.swift$' && \
    ! echo "$STAGED" | grep -q '^Content/diseases.json$' && \
    fail_drift "DiseasesConditionsService.swift" "Content/diseases.json"

# Guard 2: staged content JSON must pass the validator (new errors only;
# known pre-existing errors are baselined in Scripts/known_content_errors.txt).
# Validate the INDEX, not the working tree — they can differ, and the index is
# what the commit ships. Both files come from the index (git show :path) so the
# cross-reference check sees exactly the committed pair.
if echo "$STAGED" | grep -qE '^Content/(toxins|diseases)\.json$'; then
    echo "Content JSON staged — validating the staged (index) content..."
    TMP=$(mktemp -d) || exit 1
    trap 'rm -rf "$TMP"' EXIT
    git show :Content/toxins.json  > "$TMP/toxins.json"  2>/dev/null || cp "$REPO_ROOT/Content/toxins.json" "$TMP/toxins.json"
    git show :Content/diseases.json > "$TMP/diseases.json" 2>/dev/null || cp "$REPO_ROOT/Content/diseases.json" "$TMP/diseases.json"
    if ! python3 "$REPO_ROOT/Scripts/validate_content.py" --content-dir "$TMP" --quiet; then
        echo ""
        echo "Commit blocked: STAGED content failed validation (see errors above)."
        echo "Note: the staged version is what gets committed — 'git diff --cached Content/' shows it."
        echo "Fix and re-stage, or bypass with: git commit --no-verify"
        exit 1
    fi
fi
exit 0
